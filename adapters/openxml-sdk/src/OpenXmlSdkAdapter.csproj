<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenXmlSdkAdapter</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating minor: the weekly CI cron re-tests against the latest
         release, matching the suite's staleness policy for the other
         adapters (python-docx tracks PyPI, safe-docx tracks main). -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.*" />
  </ItemGroup>

</Project>
