{
  "dslVersion": "1.0",
  "scenarioId": "acceptDeletedParagraphMarkMergesParagraphs",
  "scenarioTitle": "Accepting a deleted paragraph mark merges the paragraph with the following paragraph",
  "specCitation": {
    "standard": "ECMA-376",
    "edition": 5,
    "part": 1,
    "section": "17.13.5.15",
    "clauseTitle": "del (Deleted Paragraph)"
  },
  "wordBehaviorNote": null,
  "inputDocumentPath": "input.docx",
  "operationDescriptor": { "operationName": "acceptAllTrackedChanges" },
  "assertionList": [
    {
      "assertionKind": "xpathQueryCount",
      "xpathExpression": "//w:body/w:p",
      "expectedCount": 1
    },
    {
      "assertionKind": "xpathQueryCount",
      "xpathExpression": "//w:pPr/w:rPr/w:del",
      "expectedCount": 0
    },
    {
      "assertionKind": "documentTextContainsAtOffset",
      "expectedSubstring": "First half second half",
      "expectedOffset": 0
    }
  ]
