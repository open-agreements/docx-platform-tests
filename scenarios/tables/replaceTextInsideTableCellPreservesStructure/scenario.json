    { "assertionKind": "xpathQueryExists", "xpathExpression": "//w:tbl/w:tr/w:tc[1]//w:t[contains(., 'Invoice total sixty dollars')]" },
    { "assertionKind": "xpathQueryCount", "xpathExpression": "//w:tbl/w:tr/w:tc//w:t[contains(., 'Invoice total thirty dollars')]", "expectedCount": 0 },
    { "assertionKind": "xpathQueryExists", "xpathExpression": "//w:tbl/w:tr/w:tc[2]//w:t[contains(., 'Neighbor cell remains')]" }
