  "wordBehaviorNote": null,
  "inputDocumentPath": "input.docx",
  "operationDescriptor": {
    "operationName": "replaceFirstTextOccurrence",
    "findText": "thirty",
    "replaceText": "sixty"
  },
  "assertionList": [
    {
      "assertionKind": "xpathElementTextEquals",
      "xpathExpression": "/w:document/w:body/w:p",
      "expectedText": "Edit target: sixty days. Controlled text sentinel Paragraph tail."
    },
    {
      "assertionKind": "xpathQueryCount",
      "xpathExpression": "//w:body//w:sdt",
      "expectedCount": 1
    },
    {
      "assertionKind": "xpathQueryCount",
      "xpathExpression": "//w:body/w:p/w:sdt[w:sdtPr/w:id[@w:val='54'] and w:sdtPr/w:tag[@w:val='dpt-inline-sdt']]",
      "expectedCount": 1
    },
    {
      "assertionKind": "xpathQueryCount",
      "xpathExpression": "//w:body/w:p/w:sdt[w:sdtPr/w:id[@w:val='54'] and w:sdtPr/w:tag[@w:val='dpt-inline-sdt']][count(*)=2 and *[1][self::w:sdtPr] and *[2][self::w:sdtContent]]",
      "expectedCount": 1
    },
    {
      "assertionKind": "xpathQueryCount",
      "xpathExpression": "//w:body/w:p/w:sdt[w:sdtPr/w:id[@w:val='54'] and w:sdtPr/w:tag[@w:val='dpt-inline-sdt']]/w:sdtPr[count(w:alias)=1 and count(w:id)=1 and count(w:tag)=1]/w:alias[@w:val='Opaque inline control'][following-sibling::w:tag[1][@w:val='dpt-inline-sdt' and following-sibling::w:id[1][@w:val='54']]]",
      "expectedCount": 1
    },
    {
      "assertionKind": "xpathElementTextEquals",
      "xpathExpression": "//w:body/w:p/w:sdt[w:sdtPr/w:id[@w:val='54'] and w:sdtPr/w:tag[@w:val='dpt-inline-sdt']]/w:sdtContent",
      "expectedText": "Controlled text sentinel"
    }
  ]
}
