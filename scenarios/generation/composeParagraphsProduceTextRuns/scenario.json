      { "paragraphText": "First generated paragraph" },
      { "paragraphText": "Second generated paragraph" }
    ]
  },
  "assertionList": [
    { "assertionKind": "xpathQueryCount", "xpathExpression": "//w:body/w:p[.//w:t[contains(., 'generated paragraph')]]", "expectedCount": 2 },
    { "assertionKind": "xpathQueryExists", "xpathExpression": "//w:body/w:p[1]//w:t[contains(., 'First generated paragraph')]" },
    { "assertionKind": "xpathQueryExists", "xpathExpression": "//w:body/w:p[2]//w:t[contains(., 'Second generated paragraph')]" }
