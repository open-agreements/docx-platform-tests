  "assertionList": [
    { "assertionKind": "xpathQueryCount", "xpathExpression": "//w:body/w:p[.//w:t]", "expectedCount": 3 },
    { "assertionKind": "xpathQueryExists", "xpathExpression": "//w:body/w:p[1]//w:t[contains(., 'Anchor paragraph')]" },
    { "assertionKind": "xpathQueryExists", "xpathExpression": "//w:body/w:p[2]//w:t[contains(., 'Inserted middle paragraph')]" },
    { "assertionKind": "xpathQueryExists", "xpathExpression": "//w:body/w:p[3]//w:t[contains(., 'Following paragraph')]" }
  ]
