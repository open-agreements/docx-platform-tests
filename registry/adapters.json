{
  "protocolVersion": 1,
  "adapters": [
    {
      "adapterName": "safe-docx",
      "adapterCommand": ["adapters/safe-docx/node_modules/.bin/safe-docx-conformance-adapter"],
      "adapterVersionCommand": ["node", "-p", "const b = require('./adapters/safe-docx/build-info.json'); b.packageVersion + '+git.' + b.sourceCommitSha.slice(0, 12)"]
    },
    {
      "adapterName": "python-docx",
      "adapterCommand": ["adapters/python-docx/.venv/bin/python", "adapters/python-docx/run_adapter.py"],
      "adapterVersionCommand": ["adapters/python-docx/.venv/bin/python", "-c", "import docx; print(docx.__version__)"]
    },
    {
      "adapterName": "libreoffice",
      "adapterCommand": ["python3", "adapters/libreoffice/run_adapter.py"],
      "adapterVersionCommand": ["soffice", "--version"]
    },
    {
      "adapterName": "openxml-sdk",
      "adapterCommand": ["bash", "adapters/openxml-sdk/run-adapter.sh"],
      "adapterVersionCommand": ["bash", "adapters/openxml-sdk/run-adapter.sh", "--print-library-version"]
    },
    {
      "adapterName": "dolanmiu-docx",
      "adapterCommand": ["node", "adapters/dolanmiu-docx/run_adapter.mjs"],
      "adapterVersionCommand": ["node", "-p", "require('./adapters/dolanmiu-docx/node_modules/docx/package.json').version"]
    }
  ]
}
