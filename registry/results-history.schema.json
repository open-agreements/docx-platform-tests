{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agreements.github.io/docx-platform-tests/registry/results-history.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "legacySchemas"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "legacySchemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["2"],
      "properties": {
        "2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceCommit",
            "fixturePath",
            "fixtureSha256",
            "canonicalSha256",
            "expectedImplementationCount",
            "expectedAdapterNames",
            "expectedScenarioCount",
            "expectedScenarioIds",
            "oracleKindByScenario"
          ],
          "properties": {
            "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "fixturePath": { "type": "string", "pattern": "^results/history/[^/]+\\.json$" },
            "fixtureSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "canonicalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "expectedImplementationCount": { "type": "integer", "minimum": 1 },
            "expectedAdapterNames": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "expectedScenarioCount": { "type": "integer", "minimum": 1 },
            "expectedScenarioIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "oracleKindByScenario": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "const": "ecma-conformance" }
            }
          }
        }
      }
    }
  }
}
