{
  "name": "docx-platform-tests-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Neutral runner for the docx-platform-tests conformance suite",
  "license": "Apache-2.0",
  "scripts": {
    "suite": "tsx src/run.ts",
    "typecheck": "tsc --noEmit",
    "sanity": "tsx src/__sanity.ts",
    "capability-sanity": "tsx src/__capability-sanity.ts",
    "pack-fixtures": "tsx src/pack-fixtures.ts",
    "check-fixtures": "tsx src/pack-fixtures.ts --check",
    "write-results-schema": "tsx src/write-results-schema.ts",
    "check-results-schema": "tsx src/write-results-schema.ts --check && tsx src/normalize-results.ts --check",
    "write-capability-index": "tsx src/check-capability-registry.ts",
    "check-capability-index": "tsx src/check-capability-registry.ts --check",
    "validate-results": "tsx src/validate-results.ts",
    "migrate-results": "tsx src/normalize-results.ts",
    "check-results-migration": "tsx src/normalize-results.ts --check",
    "render-matrix": "tsx src/render-matrix.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "ajv": "^8.17.1",
    "fflate": "^0.8.2",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
